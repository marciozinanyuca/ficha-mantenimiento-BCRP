# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (Cubre la raíz, frontend y backend)
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
**/coverage/

# next.js (Frontend)
.next/
**/ .next/
out/
**/out/

# production & builds
build/
**/build/

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
**/ .env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Fichas o documentos generados temporalmente (si aplica a tu proyecto)
Fichas_Generadas/*.docx